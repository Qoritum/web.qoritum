# Public canonical origin. Required before indexing the production site.
# Example only: confirm the real domain before enabling indexing.
SITE_URL=https://qoritum.com
SITE_INDEXABLE=false

# Paste ONLY the content value from the verification meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
META_DOMAIN_VERIFICATION=

# Public measurement IDs, not API tokens. Rebuild after changing NEXT_PUBLIC_*.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional verified company profiles. Empty entries are not rendered.
SOCIAL_LINKEDIN_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_TIKTOK_URL=

